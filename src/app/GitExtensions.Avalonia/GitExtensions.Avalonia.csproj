<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Avalonia twin of the GitExtensions entry point. -->
    <OutputType>Exe</OutputType>
    <IsPublishable>true</IsPublishable>
    <AvaloniaApplication>true</AvaloniaApplication>
    <TargetFramework>net10.0</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <UseAppHost Condition="'$(OS)' != 'Windows_NT'">false</UseAppHost>
    <RootNamespace>GitExtensions</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia"/>
    <PackageReference Include="Avalonia.Desktop"/>
    <PackageReference Include="GitInfo">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitUI.Avalonia\GitUI.Avalonia.csproj" AdditionalProperties="BuildAvalonia=true"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Cross-platform assemblies must not carry the SupportedOSPlatform("windows7.0")
         attribute from CommonAssemblyInfo.cs; use the platform-neutral variant. -->
    <Compile Remove="$(RepoRoot)\CommonAssemblyInfo.cs"/>
    <Compile Include="$(RepoRoot)\src\app\GitUI.Avalonia\Properties\CommonAssemblyInfoAvalonia.cs" Link="Properties\CommonAssemblyInfoAvalonia.cs"/>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\native\GitExtensionsShellEx\Resources\git-extensions-logo.ico"
             Link="git-extensions-logo.ico"
             CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>

</Project>
