<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitUI.FileStatusList">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="4,2">
      <TextBlock x:Name="lblCount" VerticalAlignment="Center" Opacity="0.7" />
      <Button x:Name="btnFileHistory" Grid.Column="1" Margin="4,0" />
      <Button x:Name="btnBlameFile" Grid.Column="2" />
    </Grid>
    <ListBox x:Name="lstFiles" SelectionMode="Single" />
  </DockPanel>
</UserControl>
