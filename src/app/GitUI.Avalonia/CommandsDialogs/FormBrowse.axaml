<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:GitUI.Editor"
        xmlns:commitinfo="clr-namespace:GitUI.CommitInfo"
        xmlns:leftpanel="clr-namespace:GitUI.LeftPanel"
        xmlns:revisionGrid="clr-namespace:GitUI.UserControls.RevisionGrid"
        xmlns:userControls="clr-namespace:GitUI.UserControls"
        x:Class="GitUI.CommandsDialogs.FormBrowse"
        Width="1280" Height="800"
        Title="Git Extensions">
    <DockPanel>
        <Menu x:Name="mainMenuStrip" DockPanel.Dock="Top">
            <MenuItem x:Name="repositoryToolStripMenuItem" Header="_Repository">
                <MenuItem x:Name="openToolStripMenuItem" Header="&amp;Open..." />
                <MenuItem x:Name="initializeRepositoryMenuItem" />
                <MenuItem x:Name="cloneRepositoryMenuItem" />
                <MenuItem x:Name="gitMaintenanceToolStripMenuItem">
                    <MenuItem x:Name="compressGitDatabaseToolStripMenuItem" />
                    <MenuItem x:Name="verifyRepositoryMenuItem" />
                    <MenuItem x:Name="deleteIndexLockToolStripMenuItem" />
                </MenuItem>
                <MenuItem x:Name="cleanupRepositoryMenuItem" />
                <MenuItem x:Name="reflogMenuItem" />
                <MenuItem x:Name="dashboardMenuItem" />
                <MenuItem x:Name="goToCommitMenuItem" InputGesture="Ctrl+G" />
                <MenuItem x:Name="goToSuperprojectMenuItem" />
                <Separator />
                <MenuItem x:Name="refreshToolStripMenuItem" Header="_Refresh" />
                <MenuItem x:Name="remoteManagementMenuItem" />
                <MenuItem x:Name="submoduleManagementMenuItem" />
                <MenuItem x:Name="pluginsMenuItem" />
            </MenuItem>
            <MenuItem x:Name="commandsToolStripMenuItem" Header="_Commands">
                <MenuItem x:Name="commitMenuItem" InputGesture="Ctrl+K" />
                <MenuItem x:Name="userScriptsMenuItem" />
                <Separator />
                <MenuItem x:Name="formatPatchMenuItem" />
                <MenuItem x:Name="applyPatchMenuItem" />
                <MenuItem x:Name="viewPatchMenuItem" />
                <MenuItem x:Name="fetchAllToolStripMenuItem" Header="Fetch _all" />
                <MenuItem x:Name="stashChangesMenuItem" />
                <MenuItem x:Name="stashOptionsMenuItem" />
                <MenuItem x:Name="stashManagerMenuItem" />
                <MenuItem x:Name="stashStagedMenuItem" />
                <MenuItem x:Name="resetAllMenuItem" />
                <MenuItem x:Name="undoLastCommitMenuItem" />
                <MenuItem x:Name="pullMergeMenuItem" />
                <MenuItem x:Name="pullRebaseMenuItem" />
                <MenuItem x:Name="pushMenuItem" />
                <MenuItem x:Name="forcePushMenuItem" />
                <MenuItem x:Name="pullOptionsMenuItem" />
                <MenuItem x:Name="pushOptionsMenuItem" />
            </MenuItem>
            <MenuItem x:Name="viewToolStripMenuItem">
                <MenuItem x:Name="lightThemeMenuItem" ToggleType="Radio" GroupName="ApplicationTheme" />
                <MenuItem x:Name="darkThemeMenuItem" ToggleType="Radio" GroupName="ApplicationTheme" />
                <MenuItem x:Name="systemThemeMenuItem" ToggleType="Radio" GroupName="ApplicationTheme" />
                <Separator />
                <MenuItem x:Name="keyboardShortcutsMenuItem" />
                <MenuItem x:Name="settingsMenuItem" />
                <MenuItem x:Name="commandLogMenuItem" Header="Git Command Log" />
                <MenuItem x:Name="diffToolWorkingTreeMenuItem" />
            </MenuItem>
        </Menu>
        <StackPanel x:Name="repositoryInfoPanel" DockPanel.Dock="Top" Margin="8,6" Spacing="2">
            <TextBlock x:Name="lblRepoPath" FontWeight="SemiBold" />
            <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="lblStatus" FontFamily="monospace" Opacity="0.7" TextWrapping="Wrap" />
            </ScrollViewer>
        </StackPanel>
        <Border x:Name="operationStatusPanel" DockPanel.Dock="Top" IsVisible="False" Margin="8,0,8,8" Padding="8"
                BorderBrush="DarkGoldenrod" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="lblOperationStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="btnResolveConflicts" IsVisible="False" />
                    <Button x:Name="btnContinueRebase" IsVisible="False" />
                    <Button x:Name="btnEditRebaseTodo" IsVisible="False" />
                    <Button x:Name="btnContinueMerge" IsVisible="False" />
                    <Button x:Name="btnContinuePatch" IsVisible="False" />
                    <Button x:Name="btnContinueCommitPick" IsVisible="False" />
                    <Button x:Name="btnSkipRebase" IsVisible="False" />
                    <Button x:Name="btnAbortRebase" IsVisible="False" />
                    <Button x:Name="btnAbortMerge" IsVisible="False" />
                    <Button x:Name="btnAbortPatch" IsVisible="False" />
                    <Button x:Name="btnAbortCommitPick" IsVisible="False" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Margin="8,0,8,8">
            <Grid x:Name="repositoryWorkspace" ColumnDefinitions="240,4,*">
                <leftpanel:RepoObjectsTree x:Name="repoObjectsTree" Grid.Column="0" />
                <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />
                <Grid Grid.Column="2" RowDefinitions="3*,4,2*">
                    <revisionGrid:RevisionGridControl x:Name="RevisionGrid" Grid.Row="0" />
                    <GridSplitter Grid.Row="1" Background="Transparent" ResizeDirection="Rows" />
                    <Grid Grid.Row="2" ColumnDefinitions="380,4,*">
                        <Grid Grid.Column="0" RowDefinitions="Auto,*">
                            <commitinfo:CommitInfo x:Name="CommitInfo" Grid.Row="0" MaxHeight="180" />
                            <TabControl x:Name="fileListTabs" Grid.Row="1">
                                <TabItem x:Name="commitFilesTab">
                                    <userControls:FileStatusList x:Name="fileStatusList" />
                                </TabItem>
                                <TabItem x:Name="revisionTreeTab">
                                    <userControls:RevisionFileTreePanel x:Name="revisionFileTree" />
                                </TabItem>
                                <TabItem x:Name="workingTreeTab">
                                    <userControls:WorkingTreePanel x:Name="workingTreePanel" />
                                </TabItem>
                            </TabControl>
                        </Grid>
                        <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />
                        <editor:FileViewer x:Name="fileViewer" Grid.Column="2" />
                    </Grid>
                </Grid>
            </Grid>
            <Border x:Name="dashboardPanel" IsVisible="False" Padding="24">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <TextBlock x:Name="lblDashboardTitle" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock x:Name="lblDashboardStatus" Grid.Row="1" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <ListBox x:Name="lstRecentRepositories" Grid.Row="2" />
                    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button x:Name="btnDashboardOpen" Margin="0,0,8,0" />
                        <Button x:Name="btnDashboardOpenFolder" Margin="0,0,8,0" />
                        <Button x:Name="btnDashboardRemove" Margin="0,0,8,0" />
                        <Button x:Name="btnDashboardClear" Margin="0,0,8,0" />
                        <Button x:Name="btnDashboardReturn" IsVisible="False" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>